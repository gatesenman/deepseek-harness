{
  "name": "@deepseek-ai/dsh-experimental-ontology-studio",
  "description": "Standalone web editor over dsh-experimental-ontology-model: sidebar-navigated CRUD for the six ontology entity kinds, sample-instance editing, and a testing panel running validation, rules, metrics, and instance schema checks; run with `pnpm dev` in this package",
  "version": "0.1.1-rc.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/ontology-studio"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build:app": "vite build"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-experimental-ontology-model": "workspace:^",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "vite": "^6.0.0"
  }
}
